# Cloudflare Pages response headers (other hosts ignore this file).

# Built code, styles and fonts carry their version in their name: browsers keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Bundled map data changes only with a new release: kept a day, then checked again.
/data/*
  Cache-Control: public, max-age=86400

# These must always be checked, so a new version reaches everyone at once.
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Basic protection; the app needs nothing that these forbid.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
